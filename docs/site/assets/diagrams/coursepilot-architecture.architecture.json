  "cards": [
    {
      "dot": "cyan",
      "title": "One declaration per tool",
      "items": [
        "tool_registry::TOOLS drives the MCP input schema (from execute_parameters()), the web service in db/services.php and the privacy allowlist.",
        "tools/list and tools/call use the same set."
      ]
    },
    {
      "dot": "rose",
      "title": "Access and privacy",
      "items": [
        "OAuth 2.1 with discovery (RFC 8414/9728), dynamic registration (RFC 7591) and CIMD; PKCE; no manual tokens.",
        "Remote access is checked on every call (system cohort or capability).",
        "Allowlist without learner data, enforced by a contract test."
      ]
    },
    {
      "dot": "emerald",
      "title": "Writing safely",
      "items": [
        "Catalogued types write only through add_moduleinfo()/update_moduleinfo(); drift locks just the affected type.",
        "Other installed types are created from activity XML, verified by round trip, discarded on mismatch.",
        "Every module change is captured; restore creates a new version."
      ]
    },
    {
      "dot": "amber",
      "title": "Context stays with the teacher",
      "items": [
        "One storage anchor, two adapters: Moodle private files or the teacher's own WebDAV.",
        "No fallback store: a failed write leaves a pending note without content."
      ]
    }
  ]
}