{
    "name": "matthiasgruenwald/coursepilot-plugin-ci",
    "description": "Nur Entwicklungswerkzeug fuer das Qualitaets-Gate (Spec 0029): moodle-plugin-ci. Eigenes Projekt, weil es symfony ^5.4 verlangt und mit deptrac/infection im Root-Projekt nicht aufloesbar ist.",
    "type": "project",
    "license": "AGPL-3.0-or-later",
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/moodlehq/moodle-local_ci.git"
        },
        {
            "type": "package",
            "package": {
                "name": "moodlehq/moodle-local_moodlecheck",
                "version": "1.3.2",
                "source": {
                    "url": "https://github.com/moodlehq/moodle-local_moodlecheck.git",
                    "type": "git",
                    "reference": "v1.3.2"
                }
            }
        }
    ],
    "require": {
        "moodlehq/moodle-plugin-ci": "^4.5"
    },
    "config": {
        "platform": {
            "php": "8.4.0"
        },
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
