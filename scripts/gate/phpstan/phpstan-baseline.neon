parameters:
	ignoreErrors:
		-
			# reason: $PAGE is supplied by Moodle config/bootstrap, not declared locally in this entry script/include. The attached use is resolved at runtime after bootstrap; PHPStan does not model that include-scope assignment.
			# evidence: {"admin/connections.php":["$PAGE->set_context($context);"]}
			# resolution: permanent
			message: '#^Variable \$PAGE might not be defined\.$#'
			identifier: variable.undefined
			count: 5
			path: ../html/public/local/coursepilot/admin/connections.php

		-
			# reason: lightboxgallery_image belongs to optional mod_lightboxgallery, absent from the gate installation. This call to set_caption is part of the lightboxgallery adapter/test after plugin availability is checked; the optional class cannot be scanned here.
			# evidence: {"classes/activity_files/lightboxgallery.php":["$image->set_caption($caption);"]}
			# resolution: permanent
			message: '#^Call to method set_caption\(\) on an unknown class lightboxgallery_image\.$#'
			identifier: class.notFound
			count: 1
			path: ../html/public/local/coursepilot/classes/activity_files/lightboxgallery.php

		-
