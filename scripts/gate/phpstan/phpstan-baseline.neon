			count: 1
			path: ../html/public/local/coursepilot/classes/activity_files/lightboxgallery.php

		-
			# reason: has_external_target($decoded) reads raw context-pointer targets from raw_pointer_for(), including absent or malformed values; @param array|null omits their value types. This is typing debt, not a PHP limitation.
