{{!
    @template local_coursepilot/location_selection_breadcrumb

    Path breadcrumb in the file window of the location selection (issue #551), filled by the
    AMD module amd/src/location_selection.js instead of being assembled from strings.

    Context variables required for this template:
    * crumbs - array - list of {label, path, last}
      * label - string - segment name (or the root label)
      * path - string - path to jump to when this crumb is clicked
      * last - bool - true for the current (non-clickable) segment

    Example context (json):
    {
        "crumbs": [
            {"label": "Wurzel", "path": "", "last": false},
            {"label": "Unterricht", "path": "Unterricht", "last": true}
        ]
    }
}}
<nav>
    <ol class="breadcrumb mb-0">
    {{#crumbs}}
        <li class="breadcrumb-item{{#last}} active{{/last}}">
            {{^last}}<a href="#" data-crumb-path="{{path}}">{{label}}</a>{{/last}}
            {{#last}}{{label}}{{/last}}
        </li>
    {{/crumbs}}
    </ol>
</nav>
