{{!
    @template local_coursepilot/admin_connections

    Administrationsuebersicht aller aktiven Fernzugriffsverbindungen auf
    admin/connections.php.

    Context variables required for this template:
    * revokeallurl - string - form action URL for the bulk-revoke button
    * sesskey - string - Moodle session key
    * revokeallonsubmit - string - JS "return confirm(...)" expression for the bulk-revoke form
    * empty - bool - true when there are no active connections at all
    * rows - array - list of {person: string, clientname: string, since: string, expires: string, ablageortlines: array of {text: string}, revokeurl: string}, present when not empty

    Example context (json):
    {
        "revokeallurl": "https://example.test/local/coursepilot/admin/connections.php",
        "sesskey": "abc123",
        "revokeallonsubmit": "return confirm(\"Really invalidate every issued access token?\");",
        "empty": false,
        "rows": [
            {
                "person": "Lea Lehrer (lea@example.test)",
                "clientname": "Claude Desktop",
                "since": "01.09.2026, 08:00",
                "expires": "01.10.2026, 08:00",
                "ablageortlines": [{"text": "Kontextbereich: extern: cloud.example.test"}],
                "revokeurl": "https://example.test/local/coursepilot/admin/connections.php?revoke=1&sesskey=abc123"
            }
        ]
    }
}}
<p>{{#str}} connectionsintro, local_coursepilot {{/str}}</p>
<form method="post" action="{{revokeallurl}}" onsubmit="{{revokeallonsubmit}}">
    <input type="hidden" name="revokeall" value="1">
    <input type="hidden" name="sesskey" value="{{sesskey}}">
    <input type="submit" value="{{#str}} connectionrevokeall, local_coursepilot {{/str}}">
</form>
{{#empty}}<div class="alert alert-info">{{#str}} connectionnoconnections, local_coursepilot {{/str}}</div>{{/empty}}
{{^empty}}
<table class="generaltable">
    <thead>
        <tr>
            <th>{{#str}} connectionperson, local_coursepilot {{/str}}</th>
            <th>{{#str}} connectionclient, local_coursepilot {{/str}}</th>
            <th>{{#str}} connectionsince, local_coursepilot {{/str}}</th>
            <th>{{#str}} connectionexpires, local_coursepilot {{/str}}</th>
            <th>{{#str}} connectionablageort, local_coursepilot {{/str}}</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        {{#rows}}
        <tr>
            <td>{{person}}</td>
            <td>{{clientname}}</td>
            <td>{{since}}</td>
            <td>{{expires}}</td>
            <td>
                <ul class="unlist m-0">
                    {{#ablageortlines}}<li>{{text}}</li>{{/ablageortlines}}
                </ul>
            </td>
            <td><a href="{{revokeurl}}">{{#str}} connectionrevoke, local_coursepilot {{/str}}</a></td>
        </tr>
        {{/rows}}
    </tbody>
</table>
{{/empty}}
