{{!
    @template local_coursepilot/ortswahl_page

    Vollstaendige Ortswahlseite einschliesslich Leerzustand und Verlauf.

    Context variables required for this template:
    * oauthreturn - bool - true when the page is rendered after an OAuth flow returned
    * clientname - string - OAuth client name (only present if oauthreturn)
    * backurl - string - link back to the course (only present if oauthreturn)
    * finishresult - bool - true when a submit result should be shown
    * class - string - Bootstrap alert class for the result (only present if finishresult)
    * text - string - result message (only present if finishresult)
    * altbestandopen - bool - whether an unresolved Altbestand notice should show
    * notenabled - bool - true when required setup steps are still missing
    * missingstepstext - string - the missing setup steps as plain text (only present if notenabled)
    * supporturl - string - link to core support docs (only present if notenabled)
    * noinstance - bool - true when no Nextcloud instance is connected yet
    * schoolhint - string - optional admin hint for the school instance (only present if noinstance and set)
    * ready - bool - true when the editor (see local_coursepilot/ortswahl_editor) should render
    * editor - object - editor context (see local_coursepilot/ortswahl_editor), only present when ready
    * locations - array - list wrapping the current-location context (see local_coursepilot/current_locations), empty when none set
    * history - object - {empty: bool, entries: array of {date, target, from, to} }

    Example context (json):
    {
        "oauthreturn": false,
        "finishresult": false,
        "altbestandopen": false,
        "notenabled": false,
        "noinstance": false,
        "ready": true,
        "locations": [],
        "history": {
            "empty": false,
            "entries": [
                {"date": "21.09.2026", "target": "Kontextbereich", "from": "Alter Ordner", "to": "Neuer Ordner"}
            ]
        }
    }
}}
{{#oauthreturn}}
<div class="alert alert-info">{{#str}} ortswahloauthflowinfo, local_coursepilot, {{clientname}} {{/str}}</div>
<div class="mb-3"><a href="{{backurl}}">{{#str}} ortswahloauthflowback, local_coursepilot {{/str}}</a></div>
{{/oauthreturn}}
{{#finishresult}}<div class="alert {{class}}">{{text}}</div>{{/finishresult}}
<p>{{#str}} ortswahlintro, local_coursepilot {{/str}}</p>
{{#altbestandopen}}<div class="alert alert-warning">{{#str}} ortswahlaltbestandopen, local_coursepilot {{/str}}</div>{{/altbestandopen}}

{{#notenabled}}
<div class="alert alert-warning">{{#str}} ortswahlnotenabledtext, local_coursepilot {{/str}}</div>
<h4>{{#str}} ortswahlmissingstepsheading, local_coursepilot {{/str}}</h4>
<p>{{#str}} ortswahlmissingstepsintro, local_coursepilot {{/str}}</p>
<textarea class="form-control" rows="4" readonly id="coursepilot-ortswahl-missingsteps">{{missingstepstext}}</textarea>
<a href="{{supporturl}}" class="btn btn-link px-0 mt-2">{{#str}} ortswahlcoresupportlink, local_coursepilot {{/str}}</a>
{{/notenabled}}

{{#noinstance}}
<div class="alert alert-info">{{#str}} ortswahlnoinstanceheading, local_coursepilot {{/str}}</div>
<p>{{#str}} ortswahlnoinstanceintro, local_coursepilot {{/str}}</p>
<ol><li>{{#str}} ortswahlnoinstancestep1, local_coursepilot {{/str}}</li><li>{{#str}} ortswahlnoinstancestep2, local_coursepilot {{/str}}</li><li>{{#str}} ortswahlnoinstancestep3, local_coursepilot {{/str}}</li></ol>
{{#schoolhint}}<h5>{{#str}} ortswahlschoolhintheading, local_coursepilot {{/str}}</h5><p>{{schoolhint}}</p>{{/schoolhint}}
{{/noinstance}}

{{#ready}}{{#editor}}{{> local_coursepilot/ortswahl_editor}}{{/editor}}{{/ready}}
<h4>{{#str}} ortswahlcurrentheading, local_coursepilot {{/str}}</h4>
{{#locations}}{{> local_coursepilot/current_locations}}{{/locations}}
<h4>{{#str}} ortswahlhistoryheading, local_coursepilot {{/str}}</h4>
{{#history.empty}}<p>{{#str}} ortswahlhistoryempty, local_coursepilot {{/str}}</p>{{/history.empty}}
{{^history.empty}}
<table class="generaltable"><thead><tr><th>{{#str}} ortswahlhistorydate, local_coursepilot {{/str}}</th><th>{{#str}} ortswahlhistorytarget, local_coursepilot {{/str}}</th><th>{{#str}} ortswahlhistoryfrom, local_coursepilot {{/str}}</th><th>{{#str}} ortswahlhistoryto, local_coursepilot {{/str}}</th></tr></thead><tbody>{{#history.entries}}<tr><td>{{date}}</td><td>{{target}}</td><td>{{from}}</td><td>{{to}}</td></tr>{{/history.entries}}</tbody></table>
{{/history.empty}}
