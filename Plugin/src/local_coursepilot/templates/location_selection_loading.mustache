{{!
    @template local_coursepilot/location_selection_loading

    Loading indicator in the location-selection file picker (Issue #551), filled by the
    amd/src/location_selection.js instead of an innerHTML string.

    Context variables required for this template:
    * text - string - the loading message

    Example context (json):
    {
        "text": "Loading..."
    }
}}
<div class="text-muted small"><span class="spinner-border spinner-border-sm me-1"></span>{{text}}</div>
