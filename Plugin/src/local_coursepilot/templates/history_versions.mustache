{{!
    @template local_coursepilot/history_versions

    Versionsliste einer Aktivitaet auf history.php (?cmid=).

    Context variables required for this template:
    * activityname - string - name of the activity (already format_string()'d)
    * isquiz - bool - true when a quiz-specific hint should show
    * rows - array - list of {version: int, nutzer: string, zeitpunkt: string, einzeiler: string, canrestore: bool, restoreurl: string|null}
    * hinweisluecken - string - fixed note about gaps in the history
    * listurl - string - link back to the activity list

    Example context (json):
    {
        "activityname": "Erste Fassung",
        "isquiz": false,
        "rows": [
            {"version": 1, "nutzer": "Lea Lehrer", "zeitpunkt": "21.09.2026, 10:00", "einzeiler": "Version 1 (erster erfasster Stand)", "canrestore": false, "restoreurl": null}
        ],
        "hinweisluecken": "Der Verlauf ist nicht lückenlos.",
        "listurl": "https://example.test/local/coursepilot/history.php?id=2"
    }
}}
<h3>{{activityname}}</h3>
<p>{{#str}} historyintro, local_coursepilot {{/str}}</p>
{{#isquiz}}<div class="alert alert-info">{{#str}} historyquizhint, local_coursepilot {{/str}}</div>{{/isquiz}}
<table class="generaltable">
    <thead>
        <tr>
            <th>{{#str}} historycolversion, local_coursepilot {{/str}}</th>
            <th>{{#str}} historycoluser, local_coursepilot {{/str}}</th>
            <th>{{#str}} historycoltime, local_coursepilot {{/str}}</th>
            <th>{{#str}} historycolchange, local_coursepilot {{/str}}</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        {{#rows}}
        <tr>
            <td>{{version}}</td>
            <td>{{nutzer}}</td>
            <td>{{zeitpunkt}}</td>
            <td>{{einzeiler}}</td>
            <td>{{#canrestore}}<a href="{{restoreurl}}">{{#str}} historyrestore, local_coursepilot {{/str}}</a>{{/canrestore}}</td>
        </tr>
        {{/rows}}
    </tbody>
</table>
<p>{{hinweisluecken}}</p>
<a href="{{listurl}}">{{#str}} historybacktolist, local_coursepilot {{/str}}</a>
