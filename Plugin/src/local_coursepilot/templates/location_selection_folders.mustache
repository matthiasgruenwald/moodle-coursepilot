{{!
    @template local_coursepilot/location_selection_folders

    Folder list for one level in the location-selection file picker (Issue #551),
    filled by amd/src/location_selection.js instead of being assembled from
    strings.

    Context variables required for this template:
    * folders - array - list of {name}, empty when the level has no subfolders

    Example context (json):
    {
        "folders": [
            {"name": "Unterricht"},
            {"name": "Material"}
        ]
    }
}}
<div class="list-group">
{{#folders}}
    <button type="button" class="list-group-item list-group-item-action" data-folder-name="{{name}}">{{name}}</button>
{{/folders}}
</div>
