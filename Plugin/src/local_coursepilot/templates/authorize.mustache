{{!
    @template local_coursepilot/authorize

    OAuth-Zustimmungsdialog auf oauth/authorize.php.

    Context variables required for this template:
    * consenttext - string - HTML consent text (source strings already contain markup, rendered unescaped)
    * context_area - object - {text: string}
    * material_store - object - {text: string}
    * locationselectionurl - string - link to the location-selection page (with OAuth passthrough)
    * formurl - string - form action URL (this page, POST)
    * hiddenfields - array - list of {name: string, value: string} passed through both forms
    * sesskey - string - Moodle session key
    * actions - array - list of {actionvalue: string, label: string}, one form per entry (allow/deny)

    Example context (json):
    {
        "consenttext": "<strong>Claude</strong> wants access.<br><br>Shared: ...",
        "context_area": {"text": "Journals and plans: Moodle — allowed"},
        "material_store": {"text": "Material files: Moodle — allowed"},
        "locationselectionurl": "https://example.test/local/coursepilot/location_selection.php",
        "formurl": "https://example.test/local/coursepilot/oauth/authorize.php",
        "hiddenfields": [{"name": "client_id", "value": "abc"}],
        "sesskey": "abc123",
        "actions": [
            {"actionvalue": "allow", "label": "Allow connection"},
            {"actionvalue": "deny", "label": "Deny"}
        ]
    }
}}
<div class="coursepilot-consent">{{{consenttext}}}</div>

<h3>{{#str}} consentlocationheading, local_coursepilot {{/str}}</h3>
<div class="coursepilot-consent-location-intro">{{#str}} consentlocationintro, local_coursepilot {{/str}}</div>
<ul>
    <li>{{context_area.text}}</li>
    <li>{{material_store.text}}</li>
</ul>
<div class="small text-muted mb-2">{{#str}} externallocationprivacyinfo, local_coursepilot {{/str}}</div>
<div class="mb-2"><a href="{{locationselectionurl}}" class="btn btn-outline-secondary btn-sm">{{#str}} consentlocationsetuplink, local_coursepilot {{/str}}</a></div>
<br>

{{#actions}}
<form method="post" action="{{formurl}}" style="display:inline">
    {{#hiddenfields}}<input type="hidden" name="{{name}}" value="{{value}}">{{/hiddenfields}}
    <input type="hidden" name="action" value="{{actionvalue}}">
    <input type="hidden" name="sesskey" value="{{sesskey}}">
    <input type="submit" value="{{label}}">
</form>
{{/actions}}
