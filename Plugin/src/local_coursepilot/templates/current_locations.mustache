{{!
    @template local_coursepilot/current_locations

    Current locations for the context area and material store.

    Context variables required for this template:
    * context_area - object - {label: string, allowancelabel: string}
    * material_store - object - {label: string, allowancelabel: string}

    Example context (json):
    {
        "context_area": {"label": "Context area", "allowancelabel": "Example school / Class 7a"},
        "material_store": {"label": "Material store", "allowancelabel": "Example school / Biology department"}
    }
}}
<ul>
    <li>{{context_area.label}} - {{context_area.allowancelabel}}</li>
    <li>{{material_store.label}} - {{material_store.allowancelabel}}</li>
</ul>
