{
    "execute": {
        "public": true,
        "static": true,
        "returns": "array",
        "parameters": [
            {
                "name": "courseid",
                "type": "int",
                "default": "(none)"
            },
            {
                "name": "sectionnum",
                "type": "int",
                "default": "(none)"
            },
            {
                "name": "fieldsjson",
                "type": "string",
                "default": "(none)"
            },
            {
                "name": "mode",
                "type": "string",
                "default": ""
            },
            {
                "name": "grade",
                "type": "float",
                "default": -1
            },
            {
                "name": "confirmlearnerlocks",
                "type": "array",
                "default": []
            }
        ]
    },
    "parameters": {
        "class": "core_external\\external_function_parameters",
        "desc": "",
        "required": 1,
        "default": null,
        "allownull": false,
        "keys": {
            "courseid": {
                "class": "core_external\\external_value",
                "desc": "Course ID",
                "required": 1,
                "default": null,
                "allownull": true,
                "type": "int"
            },
            "sectionnum": {
                "class": "core_external\\external_value",
                "desc": "Section number (0-based)",
                "required": 1,
                "default": null,
                "allownull": true,
                "type": "int"
            },
            "fields_json": {
                "class": "core_external\\external_value",
                "desc": "JSON object field name => value - missing fields come from the form default. Required fields without a form default must be named: \"name\", \"intro\", \"subnet\" (empty = no restriction), \"browsersecurity\" (\"-\" = no restriction); \"preferredbehaviour\" otherwise comes from \"mode\". \"grade\"/\"sumgrades\" are NOT possible here (blocked), see the \"grade\" parameter.",
                "required": 1,
                "default": null,
                "allownull": true,
                "type": "raw"
            },
            "mode": {
                "class": "core_external\\external_value",
                "desc": "Mode bundle: \"mini-check\", \"progress-check\" or \"final-test\". Bundle values apply only to fields not explicitly supplied in fields_json. Empty = no bundle.",
                "required": 0,
                "default": "",
                "allownull": true,
                "type": "alphanumext"
            },
            "grade": {
                "class": "core_external\\external_value",
                "desc": "Maximum quiz grade. -1 = use the Moodle form default (admin setting quiz/maximumgrade).",
                "required": 0,
                "default": -1,
                "allownull": true,
                "type": "float"
            },
            "confirm_learner_locks": {
                "class": "core_external\\external_multiple_structure",
                "desc": "Learner locks this call sets on purpose. A learner lock is a setting after which a learner needs an action by the teacher to continue or resubmit. A call that would set an unconfirmed lock is rejected with each lock and its reason, and nothing is written. Name a lock here only when the teacher explicitly asked for it; otherwise leave the field out or choose an open value.",
                "required": 0,
                "default": [],
                "allownull": false,
                "content": {
                    "class": "core_external\\external_value",
                    "desc": "Lock id as named in a rejection: a field name, or \"teacher_grade:<cmid>\"",
                    "required": 1,
                    "default": null,
                    "allownull": true,
                    "type": "text"
                }
            }
        }
    },
    "returns": {
        "class": "core_external\\external_single_structure",
        "desc": "",
        "required": 1,
        "default": null,
        "allownull": false,
        "keys": {
            "cmid": {
                "class": "core_external\\external_value",
                "desc": "Course module ID of the newly created quiz",
                "required": 1,
                "default": null,
                "allownull": true,
                "type": "int"
            },
            "message": {
                "class": "core_external\\external_value",
                "desc": "Teacher-facing creation message",
                "required": 1,
                "default": null,
                "allownull": true,
                "type": "raw"
            },
            "created_fields": {
                "class": "core_external\\external_multiple_structure",
                "desc": "One entry per field set by the patch/bundle, plus \"grade\"",
                "required": 1,
                "default": null,
                "allownull": false,
                "content": {
                    "class": "core_external\\external_single_structure",
                    "desc": "",
                    "required": 1,
                    "default": null,
                    "allownull": false,
                    "keys": {
                        "field": {
                            "class": "core_external\\external_value",
                            "desc": "Field name",
                            "required": 1,
                            "default": null,
                            "allownull": true,
                            "type": "text"
                        },
                        "value_json": {
                            "class": "core_external\\external_value",
                            "desc": "JSON-encoded, actually persisted value",
                            "required": 1,
                            "default": null,
                            "allownull": true,
                            "type": "raw"
                        }
                    }
                }
            },
            "side_effects": {
                "class": "core_external\\external_multiple_structure",
                "desc": "Triggered side effects, empty when none were triggered",
                "required": 1,
                "default": null,
                "allownull": false,
                "content": {
                    "class": "core_external\\external_value",
                    "desc": "Teacher-facing side-effect note",
                    "required": 1,
                    "default": null,
                    "allownull": true,
                    "type": "text"
                }
            }
        }
    }
}
