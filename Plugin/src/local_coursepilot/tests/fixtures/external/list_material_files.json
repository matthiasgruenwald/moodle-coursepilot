                "type": "path"
            },
            "location": {
                "class": "core_external\\external_value",
                "desc": "\"store\" (default, the teacher's grown material store, read-only) or \"workbench\" (Coursepilot's own staging area)",
                "required": 0,
                "default": "store",
                "allownull": true,
                "type": "alpha"
            }
        }
    },
    "returns": {
        "class": "core_external\\external_single_structure",
        "desc": "",
        "required": 1,
        "default": null,
        "allownull": false,
        "keys": {
            "path": {
                "class": "core_external\\external_value",
                "desc": "Resolved subfolder relative to the material root (empty = root), using the same notation accepted by the tools",
