                "default": null,
                "allownull": false,
                "content": {
                    "class": "core_external\\external_single_structure",
                    "desc": "",
                    "required": 1,
                    "default": null,
                    "allownull": false,
                    "keys": {
                        "name": {
                            "class": "core_external\\external_value",
                            "desc": "File or folder name",
                            "required": 1,
                            "default": null,
                            "allownull": true,
                            "type": "text"
                        },
                        "type": {
                            "class": "core_external\\external_value",
                            "desc": "\"file\", \"folder\" or \"context_area\" (context area - it physically lives here inside the material store, but is not enterable via the material paths, see list_context_files)",
