        "returns": "array",
        "parameters": [
            {
                "name": "path",
                "type": "string",
                "default": ""
            },
            {
                "name": "location",
                "type": "string",
                "default": "store"
            }
        ]
    },
    "parameters": {
        "class": "core_external\\external_function_parameters",
        "desc": "",
