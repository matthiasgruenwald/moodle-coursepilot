{
    "execute": {
        "public": true,
        "static": true,
        "returns": "array",
        "parameters": [
            {
                "name": "parts",
                "type": "array",
                "default": "(none)"
            },
            {
                "name": "arrangement",
                "type": "string",
                "default": "(none)"
            },
            {
                "name": "targetpath",
                "type": "string",
                "default": "(none)"
            }
        ]
    },
    "parameters": {
        "class": "core_external\\external_function_parameters",
        "desc": "",
        "required": 1,
        "default": null,
        "allownull": false,
        "keys": {
            "parts": {
                "class": "core_external\\external_multiple_structure",
                "desc": "Ordered, non-empty list of raster parts; locations may be mixed",
                "required": 1,
                "default": null,
                "allownull": false,
                "content": {
                    "class": "core_external\\external_single_structure",
                    "desc": "",
                    "required": 1,
                    "default": null,
                    "allownull": false,
                    "keys": {
                        "sourcepath": {
                            "class": "core_external\\external_value",
                            "desc": "Source file path relative to its location root",
                            "required": 1,
                            "default": null,
                            "allownull": true,
                            "type": "path"
                        },
                        "location": {
                            "class": "core_external\\external_value",
                            "desc": "\"store\" (default, the teacher's grown material store, read-only) or \"workbench\" (Coursepilot's own staging area)",
                            "required": 0,
                            "default": "store",
                            "allownull": true,
                            "type": "alpha"
                        },
                        "crop": {
                            "class": "core_external\\external_single_structure",
                            "desc": "Optional crop from the full-resolution original, using the same coordinates as crop_material_file",
                            "required": 2,
                            "default": null,
                            "allownull": false,
                            "keys": {
                                "x0": {
                                    "class": "core_external\\external_value",
                                    "desc": "Left edge, relative 0-1",
                                    "required": 1,
                                    "default": null,
                                    "allownull": true,
                                    "type": "float"
                                },
                                "y0": {
                                    "class": "core_external\\external_value",
                                    "desc": "Top edge, relative 0-1",
                                    "required": 1,
                                    "default": null,
                                    "allownull": true,
                                    "type": "float"
                                },
                                "x1": {
                                    "class": "core_external\\external_value",
                                    "desc": "Right edge, relative 0-1",
                                    "required": 1,
                                    "default": null,
                                    "allownull": true,
                                    "type": "float"
                                },
                                "y1": {
                                    "class": "core_external\\external_value",
                                    "desc": "Bottom edge, relative 0-1",
                                    "required": 1,
                                    "default": null,
                                    "allownull": true,
                                    "type": "float"
                                }
                            }
                        },
                        "source_header_text": {
                            "class": "core_external\\external_value",
                            "desc": "Optional source reference rendered above this part in the fixed house style",
                            "required": 0,
                            "default": "",
                            "allownull": true,
                            "type": "text"
                        },
                        "expected_contenthash": {
                            "class": "core_external\\external_value",
                            "desc": "Optional SHA-1 of this source file; a mismatch aborts before writing",
                            "required": 0,
                            "default": "",
                            "allownull": true,
                            "type": "alphanumext"
                        }
                    }
                }
            },
            "arrangement": {
                "class": "core_external\\external_value",
                "desc": "vertical (top to bottom) or horizontal (left to right)",
                "required": 1,
                "default": null,
                "allownull": true,
                "type": "alpha"
            },
            "targetpath": {
                "class": "core_external\\external_value",
                "desc": "PNG target path relative to the workbench root, resolved like crop_material_file; an existing file is replaced",
                "required": 1,
                "default": null,
                "allownull": true,
                "type": "path"
            }
        }
    },
    "returns": {
        "class": "core_external\\external_single_structure",
        "desc": "",
        "required": 1,
        "default": null,
        "allownull": false,
        "keys": {
            "path": {
                "class": "core_external\\external_value",
                "desc": "Resolved PNG target path relative to the workbench root",
                "required": 1,
                "default": null,
                "allownull": true,
                "type": "text"
            },
            "sources": {
                "class": "core_external\\external_multiple_structure",
                "desc": "Source descriptions in part order",
                "required": 1,
                "default": null,
                "allownull": false,
                "content": {
                    "class": "core_external\\external_value",
                    "desc": "Source location, resolved path, byte size and modification time",
                    "required": 1,
                    "default": null,
                    "allownull": true,
                    "type": "text"
                }
            },
            "created": {
                "class": "core_external\\external_value",
                "desc": "True if a new file was created, false if replaced",
                "required": 1,
                "default": null,
                "allownull": true,
                "type": "bool"
            },
            "width": {
                "class": "core_external\\external_value",
                "desc": "Output width in pixels",
                "required": 1,
                "default": null,
                "allownull": true,
                "type": "int"
            },
            "height": {
                "class": "core_external\\external_value",
                "desc": "Output height in pixels",
                "required": 1,
                "default": null,
                "allownull": true,
                "type": "int"
            },
            "size": {
                "class": "core_external\\external_value",
                "desc": "Output size in bytes",
                "required": 1,
                "default": null,
                "allownull": true,
                "type": "int"
            },
            "contenthash": {
                "class": "core_external\\external_value",
                "desc": "SHA-1 of the output PNG",
                "required": 1,
                "default": null,
                "allownull": true,
                "type": "alphanumext"
            },
            "message": {
                "class": "core_external\\external_value",
                "desc": "Write confirmation including any quota warning",
                "required": 1,
                "default": null,
                "allownull": true,
                "type": "raw"
            }
        }
    }
}
