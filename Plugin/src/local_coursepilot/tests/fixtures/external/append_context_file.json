{
    "execute": {
        "public": true,
        "static": true,
        "returns": "array",
        "parameters": [
            {
                "name": "path",
                "type": "string",
                "default": "(none)"
            },
            {
                "name": "content",
                "type": "string",
                "default": "(none)"
            },
            {
                "name": "pendingentry",
                "type": "string",
                "default": ""
            },
            {
                "name": "expectedcontenthash",
                "type": "string",
                "default": ""
            },
            {
                "name": "courseid",
                "type": "int",
                "default": 0
            }
        ]
    },
    "parameters": {
        "class": "core_external\\external_function_parameters",
        "desc": "",
        "required": 1,
        "default": null,
        "allownull": false,
        "keys": {
            "path": {
                "class": "core_external\\external_value",
                "desc": "File path relative to the context area, e.g. \"journal.md\"",
                "required": 1,
                "default": null,
                "allownull": true,
                "type": "path"
            },
            "content": {
                "class": "core_external\\external_value",
                "desc": "Content to append",
                "required": 1,
                "default": null,
                "allownull": true,
                "type": "raw"
            },
            "pending_entry": {
                "class": "core_external\\external_value",
                "desc": "Optional: identifier of an open pending entry (from coursepilot_list_skills) - if the write succeeds, the entry disappears within the same call",
                "required": 0,
                "default": "",
                "allownull": true,
                "type": "alphanumext"
            },
            "expected_contenthash": {
                "class": "core_external\\external_value",
                "desc": "Optional, only effective at the external location: contenthash of the target file from the last read - if it does not match, the operation aborts. Without an ETag (IServ) the comparison relies on the modification time (second resolution).",
                "required": 0,
                "default": "",
                "allownull": true,
                "type": "alphanumext"
            },
            "courseid": {
                "class": "core_external\\external_value",
                "desc": "Optional: course ID, if the content belongs to a specific course - only used for a possible entry in the \"not yet saved\" notice if the storage/connection/location fails",
                "required": 0,
                "default": 0,
                "allownull": true,
                "type": "int"
            }
        }
    },
    "returns": {
        "class": "core_external\\external_single_structure",
        "desc": "",
        "required": 1,
        "default": null,
        "allownull": false,
        "keys": {
            "path": {
                "class": "core_external\\external_value",
                "desc": "Resolved file path, relative to the context area",
                "required": 1,
                "default": null,
                "allownull": true,
                "type": "text"
            },
            "created": {
                "class": "core_external\\external_value",
                "desc": "true if the file was newly created",
                "required": 1,
                "default": null,
                "allownull": true,
                "type": "bool"
            },
            "size": {
                "class": "core_external\\external_value",
                "desc": "Total file size after appending, in bytes",
                "required": 1,
                "default": null,
                "allownull": true,
                "type": "int"
            },
            "message": {
                "class": "core_external\\external_value",
                "desc": "Teacher-facing change message",
                "required": 1,
                "default": null,
                "allownull": true,
                "type": "raw"
            }
        }
    }
}
