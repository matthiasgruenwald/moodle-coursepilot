{
    "execute": {
        "public": true,
        "static": true,
        "returns": "array",
        "parameters": [
            {
                "name": "cmid",
                "type": "int",
                "default": "(none)"
            },
            {
                "name": "fieldsjson",
                "type": "string",
                "default": "(none)"
            },
            {
                "name": "mode",
                "type": "string",
                "default": ""
            },
            {
                "name": "grade",
                "type": "float",
                "default": -1
            },
            {
                "name": "confirmlearnerlocks",
                "type": "array",
                "default": []
            }
        ]
    },
    "parameters": {
        "class": "core_external\\external_function_parameters",
        "desc": "",
        "required": 1,
        "default": null,
        "allownull": false,
        "keys": {
            "cmid": {
                "class": "core_external\\external_value",
                "desc": "Course module ID of the quiz",
                "required": 1,
                "default": null,
                "allownull": true,
                "type": "int"
            },
            "fields_json": {
                "class": "core_external\\external_value",
                "desc": "JSON object field name => new value - only the fields to change (patch, not a full state). \"grade\"/\"sumgrades\" are NOT possible here (blocked), see the \"grade\" parameter. \"gradepass\" is a finite JSON number in grade points, NOT percent, from 0 to the maximum grade inclusive (0 disables the threshold). Read grade with get_module_settings: 80% of grade 10 is {\"gradepass\":8}, of grade 25 is {\"gradepass\":20}. When grade changes in this call, gradepass refers to the new maximum.",
                "required": 1,
                "default": null,
                "allownull": true,
                "type": "raw"
            },
            "mode": {
                "class": "core_external\\external_value",
                "desc": "Mode bundle: \"mini-check\", \"progress-check\" or \"final-test\". Bundle values apply only to fields not explicitly named in fields_json. Empty = keep the mode.",
                "required": 0,
                "default": "",
                "allownull": true,
                "type": "alphanumext"
            },
            "grade": {
                "class": "core_external\\external_value",
                "desc": "New maximum grade of the quiz - runs through Moodle's own grading path (scales existing attempt grades and overall feedback boundaries automatically), not via fields_json. -1 = do not change.",
                "required": 0,
                "default": -1,
                "allownull": true,
                "type": "float"
            },
            "confirm_learner_locks": {
                "class": "core_external\\external_multiple_structure",
                "desc": "Learner locks this call sets on purpose. A learner lock is a setting after which a learner needs an action by the teacher to continue or resubmit. A call that would set an unconfirmed lock is rejected with each lock and its reason, and nothing is written. Name a lock here only when the teacher explicitly asked for it; otherwise leave the field out or choose an open value.",
                "required": 0,
                "default": [],
                "allownull": false,
                "content": {
                    "class": "core_external\\external_value",
                    "desc": "Lock id as named in a rejection: a field name, or \"teacher_grade:<cmid>\"",
                    "required": 1,
                    "default": null,
                    "allownull": true,
                    "type": "text"
                }
            }
        }
    },
    "returns": {
        "class": "core_external\\external_single_structure",
        "desc": "",
        "required": 1,
        "default": null,
        "allownull": false,
        "keys": {
            "cmid": {
                "class": "core_external\\external_value",
                "desc": "Course module ID",
                "required": 1,
                "default": null,
                "allownull": true,
                "type": "int"
            },
            "message": {
                "class": "core_external\\external_value",
                "desc": "Teacher-facing change message",
                "required": 1,
                "default": null,
                "allownull": true,
                "type": "raw"
            },
            "changes": {
                "class": "core_external\\external_multiple_structure",
                "desc": "One entry per field that actually changed",
                "required": 1,
                "default": null,
                "allownull": false,
                "content": {
                    "class": "core_external\\external_single_structure",
                    "desc": "",
                    "required": 1,
                    "default": null,
                    "allownull": false,
                    "keys": {
                        "field": {
                            "class": "core_external\\external_value",
                            "desc": "Field name",
                            "required": 1,
                            "default": null,
                            "allownull": true,
                            "type": "text"
                        },
                        "before_json": {
                            "class": "core_external\\external_value",
                            "desc": "JSON-encoded value before the write",
                            "required": 1,
                            "default": null,
                            "allownull": true,
                            "type": "raw"
                        },
                        "after_json": {
                            "class": "core_external\\external_value",
                            "desc": "JSON-encoded value after the write",
                            "required": 1,
                            "default": null,
                            "allownull": true,
                            "type": "raw"
                        }
                    }
                }
            },
            "side_effects": {
                "class": "core_external\\external_multiple_structure",
                "desc": "Triggered side effects, empty when none were triggered",
                "required": 1,
                "default": null,
                "allownull": false,
                "content": {
                    "class": "core_external\\external_value",
                    "desc": "Teacher-facing side-effect note",
                    "required": 1,
                    "default": null,
                    "allownull": true,
                    "type": "text"
                }
            }
        }
    }
}
