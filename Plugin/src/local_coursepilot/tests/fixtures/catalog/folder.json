    "combination_rules": [
        "display=1 (inline) is incompatible with automatic completion tracking on view (completion=automatic + completionview) - Moodle rejects this in the form (mod/folder/mod_form.php: validation())."
    ],
    "side_effects": [
        "folder can also be created without \"files\" - an empty folder is valid, unlike resource without a main file (Spec 0015 §4.3)."
