{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/scripts/gate/gate.js\" edit",
            "timeout": 900,
            "statusMessage": "gate fast..."
          }
        ]
      }
    ]
  }
}
