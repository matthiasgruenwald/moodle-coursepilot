# Testkonfiguration fuer die Kurspilot-Spike-Instanz (local_kurspilot,
# natives Server-MCP). Kopieren nach .env.e2e.spike (gitignored) und
# ausfuellen.
#
# Nicht zu verwechseln mit .env.e2e - das zeigt weiter auf die alte Instanz
# mit local_coursepilot (siehe docs/agents/spike-instance-handout.md, 6.).

MOODLE_URL=https://spike.gruenwald.fun
MOODLE_TEST_COURSEID=6

# Nutzer, in dessen Namen die MCP-Aufrufe laufen. Muss im Kurs eingeschrieben
# sein und local/kurspilot:use haben. Ein Zugriffstoken braucht hier nicht zu
# stehen - scripts/spike-e2e-token.sh stellt eines aus.
KURSPILOT_SPIKE_USERNAME=teacher_edit

# Nur fuer Playwright-Laeufe, die die Moodle-Oberflaeche bedienen. Gleiche
# Zugangsdaten wie auf den vier regulaeren Devstack-Instanzen. Alternativ
# sicher zur Laufzeit setzen, ohne diese Datei zu aendern:
# KURSPILOT_E2E_PROFILE=spike MOODLE_USERNAME=teacher_edit MOODLE_PASSWORD=... npx playwright test test/e2e/ortswahl.spike.e2e.spec.js
MOODLE_USERNAME=
MOODLE_PASSWORD=

# Container-Name des Spike-Webservers (Standard, nur bei Abweichung setzen).
# KURSPILOT_SPIKE_CONTAINER=moodle-kurspilot-spike-webserver-1
